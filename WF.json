{
  "name": "Creation ERP -> Notification Slack",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "erp-order-created",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "trigger-1",
      "name": "ERP Event Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": "={{$env.SLACK_CHANNEL_ID}}",
        "text": "=Nouvelle commande creee : {{$json[\"body\"][\"order_id\"]}} - {{$json[\"body\"][\"customer_name\"]}}",
        "otherOptions": {}
      },
      "id": "action-1",
      "name": "Notify Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [
        500,
        300
      ]
    }
  ],
  "connections": {
    "ERP Event Webhook": {
      "main": [
        [
          {
            "node": "Notify Slack",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}